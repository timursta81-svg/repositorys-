* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f3f6fb;
    color: #202938;
    line-height: 1.6;
}

.container {
    width: min(1100px, 92%);
    margin: 0 auto;
}

.header {
    background: #173b68;
    color: white;
    padding: 36px 0;
}

.header h1 {
    margin: 8px 0;
    font-size: clamp(28px, 5vw, 42px);
}

.eyebrow {
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 12px;
    opacity: 0.8;
}

.subtitle {
    margin-bottom: 0;
    color: #d9e8ff;
}

main {
    padding-top: 24px;
    padding-bottom: 30px;
}

.panel {
    background: white;
    padding: 24px;
    margin-bottom: 22px;
    border-radius: 14px;
    box-shadow: 0 5px 20px rgba(20, 40, 70, 0.06);
}

h2 {
    margin-top: 0;
}

label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
}

select,
input {
    width: 100%;
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 15px;
    background: white;
}

.controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
}

button {
    border: 0;
    border-radius: 8px;
    padding: 12px 18px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    background: #2463a6;
    color: white;
}

button:hover {
    background: #174b84;
}

button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

button.secondary {
    background: #e7edf5;
    color: #24364d;
}

button.secondary:hover {
    background: #d6e0ed;
}

.status {
    padding: 12px;
    background: #eef4fb;
    border-radius: 8px;
    overflow-wrap: anywhere;
}

.status.success {
    background: #e8f8ed;
    color: #176534;
}

.status.error {
    background: #fff0f0;
    color: #a32121;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 22px;
}

.stat-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 5px 20px rgba(20, 40, 70, 0.05);
}

.stat-card span {
    display: block;
    color: #64748b;
    font-size: 14px;
}

.stat-card strong {
    display: block;
    font-size: 30px;
    margin-top: 4px;
}

.results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.result-card {
    border: 1px solid #e1e8f0;
    border-radius: 10px;
    padding: 18px;
    background: #fff;
    min-width: 0;
}

.result-card h3 {
    font-size: 17px;
    margin: 0 0 10px;
    overflow-wrap: anywhere;
}

.result-card p {
    margin: 6px 0;
    color: #526176;
    overflow-wrap: anywhere;
}

.card-number {
    display: inline-block;
    background: #e8f1ff;
    color: #174b84;
    padding: 3px 9px;
    border-radius: 20px;
    font-size: 12px;
    margin-bottom: 10px;
}

.search-container {
    margin-bottom: 18px;
}

.muted {
    color: #64748b;
    font-size: 14px;
}

.empty {
    padding: 24px;
    text-align: center;
    color: #64748b;
}

.hidden {
    display: none !important;
}

footer {
    text-align: center;
    color: #64748b;
    font-size: 14px;
    padding: 12px;
}

@media (max-width: 650px) {
    .stats {
        grid-template-columns: 1fr;
    }

    .results {
        grid-template-columns: 1fr;
    }

    .panel {
        padding: 18px;
    }

    .controls button {
        width: 100%;
    }
}
