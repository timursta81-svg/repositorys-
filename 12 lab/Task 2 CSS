body {
    font-family: Arial;
    background: #eef2f7;
    display: flex;
    justify-content: center;
    padding-top: 100px;
}

.container {
    background: white;
    padding: 30px;
    width: 350px;
    text-align: center;
    border-radius: 12px;
}

input {
    display: block;
    width: 90%;
    padding: 12px;
    margin: 10px auto;
}

button {
    width: 100%;
    padding: 12px;
    background: #2563eb;
    color: white;
    border: none;
    cursor: pointer;
}

#message {
    color: red;
}
