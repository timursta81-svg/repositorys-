body {
    font-family: Arial;
    background: #e8eef5;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.container {
    background: white;
    padding: 30px;
    width: 320px;
    border-radius: 12px;
    text-align: center;
}

input {
    width: 90%;
    padding: 12px;
    margin: 8px;
}

button {
    width: 100%;
    padding: 12px;
    background: #2563eb;
    color: white;
    border: none;
    cursor: pointer;
    margin-top: 10px;
}

#message {
    color: red;
}
