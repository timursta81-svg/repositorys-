import { useState } from "react";

function LikeButton({ title }) {
  const [likes, setLikes] = useState(0);

  return (
    <div>
      <h2>{title}</h2>
      <p>Количество лайков: {likes}</p>

      <button onClick={() => setLikes(likes + 1)}>
        ❤️ Нравится
      </button>

      <button onClick={() => setLikes(0)}>
        Сбросить
      </button>
    </div>
  );
}

export default LikeButton;
