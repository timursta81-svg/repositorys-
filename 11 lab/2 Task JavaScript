
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f0f2f5;
  color: black;
}

.container {
  max-width: 1100px;
  margin: 30px auto;
  padding: 20px;
}

h1 {
  text-align: center;
}

.card {
  background: white;
  padding: 20px;
  margin: 20px 0;
  border-radius: 10px;
  box-shadow: 0 2px 8px #ccc;
}

button {
  padding: 9px 14px;
  margin: 5px;
  border: none;
  border-radius: 5px;
  background: #333;
  color: white;
  cursor: pointer;
}

button:hover {
  background: #555;
}

input {
  padding: 10px;
  width: 60%;
  border: 1px solid #aaa;
  border-radius: 5px;
}

.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  padding: 8px;
  background: #eee;
  border-radius: 5px;
}

.completed {
  text-decoration: line-through;
  color: gray;
}

.kanban {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.column {
  background: #eee;
  padding: 12px;
  border-radius: 8px;
  min-height: 150px;
}

.task-card {
  background: white;
  padding: 10px;
  margin: 10px 0;
  border-radius: 6px;
  box-shadow: 0 1px 4px #bbb;
}

@media (max-width: 700px) {
  .kanban {
    grid-template-columns: 1fr;
  }
}
