<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kanban Board</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Kanban-доска</h1>

        <div class="input-area">
            <input id="cardInput" type="text" placeholder="Новая задача">
            <button id="addCardBtn">Добавить</button>
        </div>

        <div class="board">
            <section class="column">
                <h2>Новые</h2>
                <div id="newColumn" class="cards"></div>
            </section>

            <section class="column">
                <h2>В работе</h2>
                <div id="workColumn" class="cards"></div>
            </section>

            <section class="column">
                <h2>Готово</h2>
                <div id="doneColumn" class="cards"></div>
            </section>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
style.css
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f2f2f2;
}

.container {
    width: 1100px;
    max-width: 95%;
    margin: 35px auto;
}

h1 {
    text-align: center;
}

.input-area {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
}

#cardInput {
    width: 400px;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
}

button {
    border: none;
    border-radius: 6px;
    padding: 9px 12px;
    cursor: pointer;
    background: #333;
    color: white;
}

.board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.column {
    min-height: 400px;
    padding: 15px;
    background: white;
    border-radius: 10px;
}

.column h2 {
    text-align: center;
}

.card {
    padding: 15px;
    margin-bottom: 12px;
    background: #eeeeee;
    border-radius: 8px;
}

.card-text {
    display: block;
    margin-bottom: 12px;
    font-weight: bold;
}

.card button {
    margin-right: 5px;
}
script.js
const cardInput = document.querySelector("#cardInput");
const addCardBtn = document.querySelector("#addCardBtn");
const newColumn = document.querySelector("#newColumn");
const workColumn = document.querySelector("#workColumn");
const doneColumn = document.querySelector("#doneColumn");

function createCard(text) {
    const card = document.createElement("div");
    card.className = "card";

    const cardText = document.createElement("span");
    cardText.className = "card-text";
    cardText.textContent = text;

    const workBtn = document.createElement("button");
    workBtn.textContent = "В работу";

    const doneBtn = document.createElement("button");
    doneBtn.textContent = "Готово";

    const backBtn = document.createElement("button");
    backBtn.textContent = "Назад";

    workBtn.addEventListener("click", () => {
        workColumn.append(card);
        updateButtons();
    });

    doneBtn.addEventListener("click", () => {
        doneColumn.append(card);
        updateButtons();
    });

    backBtn.addEventListener("click", () => {
        newColumn.append(card);
        updateButtons();
    });

    card.append(cardText, workBtn, doneBtn, backBtn);

    function updateButtons() {
        const parent = card.parentElement;

        workBtn.style.display =
            parent === newColumn ? "inline-block" : "none";

        doneBtn.style.display =
            parent === workColumn ? "inline-block" : "none";

        backBtn.style.display =
            parent === doneColumn ? "inline-block" : "none";
    }

    updateButtons();

    return card;
}

function addCard() {
    const text = cardInput.value.trim();

    if (text === "") {
        alert("Введите название задачи!");
        return;
    }

    const card = createCard(text);
    newColumn.append(card);

    cardInput.value = "";
    cardInput.focus();
}

addCardBtn.addEventListener("click", addCard);

cardInput.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
        addCard();
    }
});
