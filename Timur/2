<form id="hotelForm">
  <label for="name">Имя:</label>
  <input type="text" id="name" name="name" required>

  <label for="guests">Количество гостей:</label>
  <input
    type="number"
    id="guests"
    name="guests"
    min="1"
    max="6"
    required
  >

  <label for="roomType">Тип номера:</label>
  <select id="roomType" name="roomType" required>
    <option value="">Выберите номер</option>
    <option value="standard">Стандарт</option>
    <option value="deluxe">Делюкс</option>
    <option value="suite">Люкс</option>
  </select>

  <fieldset>
    <legend>Дополнительные услуги:</legend>

    <label>
      <input type="checkbox" name="services" value="breakfast">
      Завтрак
    </label>

    <label>
      <input type="checkbox" name="services" value="transfer">
      Трансфер
    </label>

    <label>
      <input type="checkbox" name="services" value="spa">
      SPA
    </label>
  </fieldset>

  <button type="submit">Забронировать</button>
</form>

<script>
  document.getElementById("hotelForm").addEventListener("submit", function (event) {
    if (!this.checkValidity()) {
      event.preventDefault();
      this.reportValidity();
    }
  });
</script>
