
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Мои задачи</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#eef2ff;font-family:Arial,sans-serif;color:#202945}
.container{max-width:650px;margin:60px auto;padding:25px;background:white;border-radius:18px;box-shadow:0 8px 30px #293b6915}
h1{text-align:center}
.subtitle{text-align:center;color:#77809a}
.form{display:flex;gap:10px;margin:25px 0}
input{flex:1;min-width:0;padding:13px;border:1px solid #ccd3e3;border-radius:8px;font-size:16px}
button{border:0;border-radius:8px;padding:12px 16px;background:#4b62d1;color:white;cursor:pointer}
button:hover{background:#3349b0}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.filters button{background:#e8ecff;color:#3349b0}
.filters button.active{background:#4b62d1;color:white}
ul{list-style:none;padding:0}
li{display:flex;align-items:center;gap:10px;padding:13px 0;border-bottom:1px solid #edf0f6}
li span{flex:1;overflow-wrap:anywhere}
li.done span{text-decoration:line-through;color:#9299aa}
li input{flex:0 0 auto;width:18px;height:18px}
li .delete{background:#e74b60;padding:8px 12px}
#stats{text-align:center;color:#77809a}
@media(max-width:500px){.container{margin:15px;padding:18px}.form{flex-wrap:wrap}.form input{width:100%;flex-basis:100%}}
</style>
</head>
<body>
<div class="container">
<h1>✅ Мои задачи</h1>
<p class="subtitle">Планируй день и достигай целей</p>
<form class="form" id="taskForm">
<input id="taskInput" placeholder="Напиши новую задачу..." required maxlength="150">
<button type="submit">Добавить</button>
</form>
<div class="filters">
<button type="button" class="active" data-filter="all">Все</button>
<button type="button" data-filter="active">Активные</button>
<button type="button" data-filter="done">Выполненные</button>
</div>
<ul id="taskList"></ul>
<p id="stats">Всего задач: 0</p>
</div>
<script>
let tasks=[];
let filter="all";
const form=document.getElementById("taskForm");
const input=document.getElementById("taskInput");
const list=document.getElementById("taskList");
const stats=document.getElementById("stats");

form.addEventListener("submit",e=>{
e.preventDefault();
const text=input.value.trim();
if(!text)return;
tasks.push({id:Date.now()+Math.random(),text,done:false});
input.value="";
render();
});

document.querySelectorAll("[data-filter]").forEach(button=>{
button.addEventListener("click",()=>{
filter=button.dataset.filter;
document.querySelectorAll("[data-filter]").forEach(b=>b.classList.toggle("active",b===button));
render();
});
});

function render(){
list.replaceChildren();
const visible=tasks.filter(t=>filter==="all"||(filter==="active"&&!t.done)||(filter==="done"&&t.done));
visible.forEach(task=>{
const li=document.createElement("li");
if(task.done)li.classList.add("done");
const checkbox=document.createElement("input");
checkbox.type="checkbox";
checkbox.checked=task.done;
checkbox.setAttribute("aria-label","Отметить задачу выполненной");
checkbox.addEventListener("change",()=>{
task.done=checkbox.checked;
render();
});
const text=document.createElement("span");
text.textContent=task.text;
const del=document.createElement("button");
del.className="delete";
del.textContent="Удалить";
del.addEventListener("click",()=>{
tasks=tasks.filter(t=>t.id!==task.id);
render();
});
li.append(checkbox,text,del);
list.append(li);
});
const completed=tasks.filter(t=>t.done).length;
stats.textContent=`Всего задач: ${tasks.length} · Выполнено: ${completed}`;
if(visible.length===0){
const li=document.createElement("li");
li.textContent="Задач пока нет";
list.append(li);
}
}
render();
</script>
</body>
</html>
